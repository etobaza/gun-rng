{
   "version": "2.0.0",
   "tasks": [
      {
         "label": "Install Rokit Tools",
         "type": "process",
         "command": "rokit",
         "args": ["install"],
         "problemMatcher": []
      },
      {
         "label": "Generate Sourcemap",
         "type": "process",
         "command": "powershell.exe",
         "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            ".vscode/generate-sourcemap.ps1"
         ],
         "problemMatcher": []
      },
      {
         "label": "Setup Project Toolchain",
         "dependsOrder": "sequence",
         "dependsOn": [
            "Install Rokit Tools",
            "Generate Sourcemap"
         ],
         "group": {
            "kind": "build",
            "isDefault": true
         },
         "problemMatcher": []
      }
   ]
}
