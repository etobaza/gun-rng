{
    "files.eol": "\n",
    "editor.semanticHighlighting.enabled": true,
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 3,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "luau-lsp.completion.autocompleteEnd": true,
    "luau-lsp.fflags.enableNewSolver": true,
    "luau-lsp.hover.showTableKinds": true,
    "luau-lsp.plugin.maximumRequestBodySize": "50mb",
    "luau-lsp.plugin.enabled": true,
    "luau-lsp.completion.imports.enabled": true,
    "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[lua]": {
        "editor.defaultFormatter": "JohnnyMorganz.stylua"
    },
    "[luau]": {
        "editor.defaultFormatter": "JohnnyMorganz.stylua"
    },
    "search.exclude": {
        "Packages/**": true,
        "ServerPackages/**": true
    },
   "stylua.targetReleaseVersion": "latest",
   "stylua.disableVersionCheck": true
}
